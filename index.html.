<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#111111">
<title>Pizzaria Aragão | PIX</title>
<style>
*{box-sizing:border-box}
body{margin:0;min-height:100vh;padding:28px 18px;display:grid;place-items:center;background:#f2f2f2;color:#171717;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
main{width:100%;max-width:420px;background:#fff;border-radius:24px;padding:30px 24px;text-align:center;box-shadow:0 12px 40px rgba(0,0,0,.08)}
.logo{width:64px;height:64px;margin:0 auto 16px;border-radius:20px;background:#171717;color:#fff;display:grid;place-items:center;font-size:30px;font-weight:800}
h1{font-size:27px;margin:0 0 8px} .sub{color:#666;line-height:1.5;margin:0}
.amount{margin:22px 0 8px;padding:14px;background:#f7f7f7;border:1px solid #e8e8e8;border-radius:14px;font-size:14px;color:#555}
.qr-wrap{margin:18px auto 14px;padding:12px;border:1px solid #eee;border-radius:18px;width:max-content;max-width:100%}
.qr{display:block;width:230px;height:230px;max-width:100%;image-rendering:pixelated}
button{width:100%;padding:16px;border:0;border-radius:13px;background:#151515;color:#fff;font-size:16px;font-weight:700;cursor:pointer}
button:active{transform:scale(.99)}
#status{min-height:22px;margin-top:12px;color:#16803c;font-size:13px}
.hint{font-size:12px;color:#888;line-height:1.5;margin-top:18px}
</style>
</head>
<body>
<main>
  <div class="logo">A</div>
  <h1>Pizzaria Aragão</h1>
  <p class="sub">Pague com PIX de forma rápida e segura.</p>
  <div class="amount">Escaneie o QR Code com o aplicativo do seu banco</div>
  <div class="qr-wrap"><img class="qr" src="data:image/png;base64," alt="QR Code PIX da Pizzaria Aragão"></div>
  <button id="copy" type="button">Copiar chave PIX</button>
  <div id="status" role="status" aria-live="polite"></div>
  <p class="hint">Depois de copiar, abra o aplicativo do seu banco e escolha pagar com chave PIX. Confira o destinatário antes de confirmar.</p>
</main>
<script>
const pixKey = "fs29925550@gmail.com";
const status = document.getElementById("status");
document.getElementById("copy").addEventListener("click", async () => {
  try {
    await navigator.clipboard.writeText(pixKey);
    status.textContent = "Chave PIX copiada! Abra o aplicativo do seu banco.";
  } catch (e) {
    status.textContent = "Não foi possível copiar automaticamente. Tente novamente ou use o QR Code.";
  }
});
</script>
</body>
</html>
